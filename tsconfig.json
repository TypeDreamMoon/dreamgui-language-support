{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "I:/VSCodeExt/dreamfx-language-support/node_modules/@types",
      "node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "I:/VSCodeExt/dreamfx-language-support/node_modules/*",
        "node_modules/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
