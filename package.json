{
  "name": "dreamui-language-support",
  "displayName": "DreamUI Language Support",
  "description": "Language support for DreamGUI .dui widget hierarchies: completion, hover, outline, diagnostics, driven by symbols the Unreal plugin exports.",
  "version": "0.3.0",
  "publisher": "typedreammoon",
  "author": {
    "name": "TypeDreamMoon"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "dreamui",
    "dreamgui",
    "dui",
    "unreal",
    "ui",
    "widget"
  ],
  "activationEvents": [
    "onLanguage:dui",
    "workspaceContains:**/*.dui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dui",
        "aliases": [
          "DreamUI",
          "dui"
        ],
        "extensions": [
          ".dui"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/dui-light.svg",
          "dark": "./resources/dui-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dui",
        "scopeName": "source.dui",
        "path": "./syntaxes/dui.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dui",
        "path": "./snippets/dui.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "dreamui.reloadSymbols",
        "title": "DreamUI: Reload Symbols (.dui-symbols.json)",
        "icon": "$(refresh)"
      },
      {
        "command": "dreamui.newFile",
        "title": "DreamUI: New .dui File",
        "icon": "$(new-file)"
      },
      {
        "command": "dreamui.revealInDesigner",
        "title": "DreamUI: Reveal in Unreal Designer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dreamui.compileFile",
        "title": "DreamUI: Compile This File",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dreamui.clearBridgeCache",
        "title": "DreamUI: Clear Bridge Caches"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dreamui.newFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@30"
        }
      ],
      "editor/title": [
        {
          "command": "dreamui.revealInDesigner",
          "when": "resourceLangId == dui",
          "group": "navigation@10"
        },
        {
          "command": "dreamui.compileFile",
          "when": "resourceLangId == dui",
          "group": "navigation@11"
        }
      ],
      "editor/context": [
        {
          "command": "dreamui.revealInDesigner",
          "when": "resourceLangId == dui",
          "group": "dreamui@1"
        },
        {
          "command": "dreamui.compileFile",
          "when": "resourceLangId == dui",
          "group": "dreamui@2"
        }
      ]
    },
    "configuration": {
      "title": "DreamUI",
      "properties": {
        "dreamui.symbolsPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to .dui-symbols.json. Empty = search each workspace folder's DUI/ directory and the folders above the open file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "node esbuild.js --watch",
    "bundle": "node esbuild.js",
    "build": "npm run compile && node esbuild.js --production",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
